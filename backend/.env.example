# Application Settings
APP_NAME="Vietnamese OCR & Document Extraction Service"
ENVIRONMENT="local"
DEBUG=true
API_V1_PREFIX="/api/v1"
HOST="0.0.0.0"
PORT=8000

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:8000","http://localhost:8000","http://localhost:5173"]

# Models Configuration
MODELS_DIR="models"
DEFAULT_DEVICE="auto"
DROP_SCORE=0.5
MAX_IMAGE_SIZE=960

# Logging
LOG_LEVEL="INFO"
